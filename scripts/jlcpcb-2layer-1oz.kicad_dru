(version 1)
(rule "JLCPCB 2-layer 1oz copper clearance" (constraint clearance (min 0.1mm)))
(rule "Different-net SMT pad spacing"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint clearance (min 0.15mm)))
(rule "Standard drilled vias"
  (constraint annular_width (min 0.075mm))
  (constraint via_diameter (min 0.45mm))
  (constraint hole_size (min 0.3mm)))
(rule "Component plated-hole annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.18mm)))
(rule "Copper to routed outline" (constraint edge_clearance (min 0.2mm)))
(rule "Drilled hole to other copper" (constraint hole_clearance (min 0.2mm)))
(rule "Component plated-hole to other copper"
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole')")
  (constraint hole_clearance (min 0.28mm)))
(rule "Via hole spacing" (constraint hole_to_hole (min 0.2mm)))
